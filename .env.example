# Supabase
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Magic Links (any random string, used to sign JWTs)
MAGIC_LINK_SECRET=change-me-to-a-random-secret

# Email — Resend
# In non-production, emails are LOGGED to the console (no API call) unless
# RESEND_TEST_TO is set. Set RESEND_TEST_TO to your inbox to actually receive
# test emails (and prefix them with [TEST]). This protects the 3K/mo quota.
RESEND_API_KEY=
RESEND_TEST_TO=
# Optional overrides — defaults shown. Domain must be verified in Resend.
RESEND_FROM_NOTIFICATIONS="Bukify <notifications@bukify.io>"
RESEND_FROM_BILLING="Bukify Billing <billing@bukify.io>"
RESEND_FROM_HELLO="Bukify <hello@bukify.io>"

# App URL (used for magic link URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (for Drive token refresh — same credentials as Supabase Google provider)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Polar.sh (subscription billing)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Seafile storage (file uploads for PDFs and covers)
SEAFILE_URL=https://your-seafile-instance.com
SEAFILE_TOKEN=your-api-token
SEAFILE_REPO_ID=your-library-id
